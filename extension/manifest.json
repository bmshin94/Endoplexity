{
  "manifest_version": 3,
  "name": "CometClone",
  "version": "0.0.1",
  "description": "Agentic browser control driven by your own Claude / Cursor subscriptions",
  "permissions": ["sidePanel", "debugger", "tabs", "storage"],
  "host_permissions": ["<all_urls>"],
  "background": {
    "service_worker": "sw.js",
    "type": "module"
  },
  "side_panel": {
    "default_path": "panel.html"
  },
  "action": {
    "default_title": "Open CometClone"
  }
}
